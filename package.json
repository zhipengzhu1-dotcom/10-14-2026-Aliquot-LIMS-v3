{
  "name": "aliquot-lims",
  "version": "1.0.0",
  "description": "Aliquot — LIMS + electronic lab notebook for contract analytical laboratories",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch scripts/dev.js",
    "check": "node scripts/check.js",
    "backup": "node scripts/backup.js",
    "test": "node --test test/*.test.js",
    "test:upgrade": "node --test test/upgrade.test.js"
  }
}
